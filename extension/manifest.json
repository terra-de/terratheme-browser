{
  "manifest_version": 3,
  "name": "Terra Theme Browser",
  "version": "0.1.0",
  "description": "Automatically theme your browser and supported websites using terratheme palette colors",

  "browser_specific_settings": {
    "gecko": {
      "id": "terra-theme-browser@terra-de.org",
      "strict_min_version": "112.0"
    }
  },

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  },

  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "theme"
  ],

  "host_permissions": [
    "*://github.com/*",
    "*://chatgpt.com/*",
    "*://www.reddit.com/*",
    "*://www.youtube.com/*",
    "*://monkeytype.com/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://chatgpt.com/*",
        "*://www.reddit.com/*",
        "*://www.youtube.com/*",
        "*://monkeytype.com/*"
      ],
      "js": ["sites/sites.js", "content-script.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Terra Theme Browser",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg",
      "128": "icons/icon-128.svg"
    }
  }
}
